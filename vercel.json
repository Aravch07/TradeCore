{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "buildCommand": "",
  "installCommand": "",
  "outputDirectory": "web",
  "headers": [
    {"source": "/engine.wasm", "headers": [{"key":"Content-Type","value":"application/wasm"},{"key":"Cache-Control","value":"public, max-age=0, must-revalidate"}]},
    {"source": "/(.*)", "headers": [{"key":"X-Content-Type-Options","value":"nosniff"},{"key":"Referrer-Policy","value":"strict-origin-when-cross-origin"},{"key":"X-Frame-Options","value":"DENY"}]}
  ]
}
